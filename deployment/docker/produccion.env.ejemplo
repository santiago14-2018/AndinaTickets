# AndinaTickets en producción: copiar como .env.produccion (en esta misma carpeta) y completar.
# El .env.produccion NO va a Git (tiene claves). Se respalda cifrado, como los demás .env.
# Lo que no está acá ya viene fijo en docker-compose.produccion.yml.

# --- Dirección pública (sección [pretix] url). Con ella se arman los enlaces de los correos y de los PDF y el QR
# para conectar AndinaScan: cambiarla después de vender rompe los enlaces ya mandados.
PRETIX_PRETIX_URL=https://entradas.andinatickets.com.ar
PRETIX_PRETIX_INSTANCE_NAME=AndinaTickets

# --- Clave interna de Django: un texto largo al azar, que no cambie nunca (firma sesiones y enlaces). Por ejemplo:
#   python3 -c "import secrets; print(secrets.token_urlsafe(50))"
PRETIX_DJANGO_SECRET=

# --- La base (la misma clave en los dos lugares: una la usa PostgreSQL, la otra pretix).
POSTGRES_DB=andina_tickets
POSTGRES_USER=andina
POSTGRES_PASSWORD=
PRETIX_DATABASE_NAME=andina_tickets
PRETIX_DATABASE_USER=andina
PRETIX_DATABASE_PASSWORD=

# --- Correo (Brevo). DigitalOcean bloquea los puertos 25, 465 y 587: se usa el 2525.
PRETIX_MAIL_FROM=entradas@andinatickets.com.ar
PRETIX_MAIL_HOST=smtp-relay.brevo.com
PRETIX_MAIL_PORT=2525
PRETIX_MAIL_TLS=true
PRETIX_MAIL_USER=
PRETIX_MAIL_PASSWORD=
# A quién le llegan los avisos de errores del sistema.
PRETIX_MAIL_ADMINS=

# --- Los otros programas de AndinaTickets.
# La cartelera (repositorio aparte): el logo de arriba de la tienda lleva ahí.
ANDINA_CARTELERA_URL=https://andinatickets.com.ar
# Liquidaciones (repositorio privado aparte), por la red interna "andina". La clave es la misma que CLAVE_PORTAL
# en el .env de Liquidaciones.
ANDINA_LIQUIDACIONES_URL=http://liquidaciones:8000
ANDINA_LIQUIDACIONES_CLAVE=

# --- Procesos de gunicorn (pretix pone 2 por núcleo; con 4 GB compartidos alcanza con 3).
NUM_WORKERS=3

# --- Copias diarias (en deployment/docker/copias): cuántos días se guardan.
# COPIAS_DIAS=14
